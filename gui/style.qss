QWidget { background: #0e1117; color: #c9d1d9; font-family: 'Segoe UI'; font-size: 13px; }
QFrame#header, QGroupBox { background: #161b22; border: 1px solid #30363d; border-radius: 8px; }
QFrame#header { padding: 8px; }
QGroupBox { margin-top: 16px; padding: 18px 12px 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 6px; color: #aab5c5; font-size: 14px; font-weight: 700; }
QLabel { background: transparent; border: none; }
QLabel#brand { color: #ffffff; font-size: 24px; font-weight: 700; }
QLabel#pageTitle { font-size: 26px; font-weight: 700; color: #ffffff; }
QLabel#subtitle { color: #8b949e; }
QPushButton, QToolButton { background: #21262d; border: 1px solid #30363d; border-radius: 6px; padding: 8px 14px; font-weight: 600; }
QPushButton:hover, QToolButton:hover { background: #30363d; border-color: #00a8ff; }
QPushButton:pressed { background: #0e1117; }
QPushButton:focus, QToolButton:focus, QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #00a8ff; }
QPushButton:disabled, QToolButton:disabled { background: #161b22; color: #8b949e; border-color: #21262d; }
QPushButton#startBtn { background: #00e676; color: #052b1a; border-color: #36ff9a; font-size: 16px; font-weight: 800; padding: 10px 22px; }
QPushButton#startBtn:hover { background: #5dffa8; border-color: #97ffc9; }
QPushButton#stopBtn { background: #ff1744; color: white; border-color: #ff647c; font-size: 16px; font-weight: 800; padding: 10px 22px; }
QPushButton#stopBtn:hover { background: #ff4569; }
QPushButton#primary { background: #005f91; color: #ffffff; border-color: #00a8ff; }
QPushButton#primary:hover { background: #0078b5; }
QPushButton#startBtn:disabled, QPushButton#stopBtn:disabled, QPushButton#primary:disabled { background: #21262d; color: #8b949e; border-color: #30363d; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox { background: #0e1117; color: #c9d1d9; border: 1px solid #30363d; border-radius: 6px; padding: 7px; min-height: 18px; selection-background-color: #005f91; }
QComboBox QAbstractItemView { background: #161b22; color: #c9d1d9; selection-background-color: #005f91; }
QTabWidget::pane { border: none; }
QTabBar::tab { background: #10151d; color: #9ca9ba; padding: 13px 18px; border-bottom: 3px solid transparent; font-weight: 600; }
QTabBar::tab:selected { background: #0e1117; color: #e6f6ff; border-bottom: 3px solid #00b8ff; }
QTabBar::tab:hover { background: #161b22; color: #c9d1d9; }
QTableWidget, QListWidget, QTextEdit, QTreeWidget { background: #161b22; alternate-background-color: #1c232c; border: 1px solid #30363d; border-radius: 6px; selection-background-color: #005f91; gridline-color: #21262d; }
QHeaderView::section { background: #21262d; color: #8b949e; padding: 9px; border: none; border-bottom: 1px solid #30363d; font-weight: 600; }
QProgressBar { border: none; border-radius: 5px; background: #21262d; text-align: center; min-height: 18px; color: white; }
QProgressBar::chunk { background: #238636; border-radius: 5px; }
QCheckBox { spacing: 8px; background: transparent; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #8b949e; border-radius: 4px; background: #0e1117; }
QCheckBox::indicator:checked { background: #238636; border-color: #3fb950; }
QStatusBar { background: #161b22; color: #8b949e; }
QScrollArea { border: none; }
QToolTip { background: #21262d; color: #ffffff; border: 1px solid #30363d; padding: 6px; }
QScrollBar:vertical { background: #0e1117; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #30363d; min-height: 24px; border-radius: 5px; }
QScrollBar::handle:vertical:hover { background: #8b949e; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QLabel#playerName { color: #ffffff; font-size: 19px; font-weight: 700; }
QLabel#statValue { color: #ffffff; font-size: 20px; font-weight: 700; }
QProgressBar { min-height: 22px; font-weight: 700; }
QProgressBar[health="good"] { color: #052b1a; }
QProgressBar[health="good"]::chunk { background: #00e676; }
QProgressBar[health="warning"] { color: #1d1600; }
QProgressBar[health="warning"]::chunk { background: #ffd54f; }
QProgressBar[health="critical"] { color: #ffffff; }
QProgressBar[health="critical"]::chunk { background: #ff1744; }
QProgressBar[health="unknown"] { color: #8b949e; }
QProgressBar[health="unknown"]::chunk { background: #30363d; }
QFrame#setupStep { background: #121b25; border: 1px solid #24394a; border-radius: 8px; }
QLabel#stepBadge { background: #0b2d40; color: #00b8ff; border-radius: 6px; padding: 8px; font-size: 17px; font-weight: 800; }
QLabel#stepTitle { color: #e6f6ff; font-size: 14px; font-weight: 700; }
