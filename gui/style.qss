/* ============================================================
   PokeBot · Midnight Blue
   Azul profundo, brilho ciano e cartões de alta densidade.
   ============================================================ */

* {
    font-family: "Segoe UI";
    font-size: 13px;
    outline: none;
}

QWidget { color: #dbeaf6; }

QMainWindow, QDialog {
    background: qradialgradient(cx:0.12, cy:0.0, radius:1.05, fx:0.12, fy:0.0,
                                stop:0 #0a2a44, stop:0.28 #071827, stop:0.65 #050f1b, stop:1 #030911);
}

/* ---------- Tipografia ---------- */
QLabel { background: transparent; border: none; color: #dbeaf6; }
QLabel#brand {
    color: #f3fbff;
    font-size: 28px;
    font-weight: 800;
}
QLabel#versionBadge {
    color: #8fe7ff;
    background: #08283d;
    border: 1px solid #125176;
    border-radius: 7px;
    padding: 2px 7px;
    font-size: 10px;
    font-weight: 800;
}
QLabel#brandKicker {
    color: #65d9ff;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.8px;
}
QLabel#headerStatus {
    color: #7d97ad;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}
QLabel#headerProcess { color: #6e8ba2; font-size: 10px; }
QLabel#headerMetaDot { color: #23506c; font-size: 10px; }
QLabel#eyebrow {
    color: #22d3ee;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
}
QLabel#pageTitle { color: #f4fbff; font-size: 23px; font-weight: 800; }
QLabel#subtitle { color: #7f9bb2; font-size: 12px; }
QLabel#groupTitle { color: #eaf7ff; font-size: 14px; font-weight: 700; }
QLabel#sectionTitle { color: #eef9ff; font-size: 14px; font-weight: 700; }
QLabel#panelTitle { color: #f0faff; font-size: 18px; font-weight: 800; }
QLabel#panelSubtitle { color: #7897ae; font-size: 11px; }
QLabel#innerTitle { color: #eaf8ff; font-size: 13px; font-weight: 700; }
QLabel#hint { color: #748da3; font-size: 11px; }
QLabel#fieldLabel { color: #b7cce0; font-weight: 600; }
QLabel#iconGlyph { color: #7dd3fc; }
QLabel#playerName { color: #f4fbff; font-size: 22px; font-weight: 800; }
QLabel#statValue { color: #f4fbff; font-size: 24px; font-weight: 800; }
QLabel#metricLabel {
    color: #7592aa;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.2px;
}
QLabel#metricValue { color: #e7f5ff; font-size: 13px; font-weight: 700; }
QLabel#positionValue {
    color: #a9c9df;
    font-family: 'Cascadia Mono', 'Consolas', monospace;
    font-size: 12px;
    font-weight: 600;
}
QLabel#statusHeadline { font-size: 19px; font-weight: 800; letter-spacing: 0.2px; }
QLabel#statusDot { border: none; }
QLabel#connectionPill {
    color: #9fb8ce;
    background: #082033;
    border: 1px solid #175071;
    border-radius: 9px;
    padding: 4px 9px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
}
QLabel#stepBadge {
    background: #0b3348;
    color: #67e8f9;
    border-radius: 8px;
    padding: 8px;
    font-size: 16px;
    font-weight: 800;
}
QLabel#stepTitle { color: #e6f6ff; font-size: 14px; font-weight: 700; }

/* ---------- Cartões ---------- */
QGroupBox, QFrame#panelCard, QFrame#innerCard, QFrame#card {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #081624, stop:1 #06111d);
    border: 1px solid #12344d;
    border-radius: 15px;
}
QGroupBox {
    margin-top: 10px;
    padding: 26px 16px 16px 16px;
}
QGroupBox#sectionCard {
    margin-top: 0;
    padding: 11px 14px 12px 14px;
    background: #071421;
    border: 1px solid #11324a;
    border-radius: 13px;
}
QGroupBox#summaryCard { background: #081523; }
QGroupBox#liveCard, QGroupBox#summaryCard, QGroupBox#logCard {
    padding: 18px;
}
QFrame#panelCard {
    background: qlineargradient(x1:0, y1:0, x2:0.8, y2:1,
                                stop:0 #091827, stop:0.55 #071522, stop:1 #06111d);
    border: 1px solid #153b56;
    border-radius: 17px;
}
QFrame#innerCard {
    background: #071421;
    border: 1px solid #12324a;
    border-radius: 13px;
}
QFrame#divider { background: #123149; border: none; min-height: 1px; max-height: 1px; }
QFrame#setupStep { background: #071421; border: 1px solid #12324a; border-radius: 14px; }

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    top: 5px;
    padding: 0 6px;
    color: #eaf7ff;
    font-size: 13px;
    font-weight: 700;
}
QGroupBox#sectionCard::title { color: transparent; }

QFrame#header {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0a1f32, stop:0.55 #081827, stop:1 #071421);
    border: 1px solid #14405d;
    border-radius: 18px;
}
QFrame#brandMark {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0a3550, stop:1 #071a2b);
    border: 1px solid #1a6c91;
    border-radius: 31px;
}

/* ---------- Botões ---------- */
QPushButton, QToolButton {
    background: #0a1d2d;
    color: #e6f4ff;
    border: 1px solid #1c4660;
    border-radius: 9px;
    padding: 9px 15px;
    font-weight: 700;
    min-height: 20px;
}
QPushButton:hover, QToolButton:hover { background: #0e2c42; border-color: #2b9fd0; }
QPushButton:pressed, QToolButton:pressed { background: #07131f; }
QPushButton:focus, QToolButton:focus { border: 2px solid #67e8f9; padding: 8px 14px; }
QPushButton:disabled, QToolButton:disabled {
    background: #091520;
    color: #526b7e;
    border-color: #143044;
}

QPushButton#startBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1d9bff, stop:1 #0969d8);
    color: #ffffff;
    border: 1px solid #5cc4ff;
    font-size: 13px;
    font-weight: 800;
    padding: 11px 22px;
    border-radius: 11px;
}
QPushButton#startBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4ab4ff, stop:1 #1385ee);
}
QPushButton#stopBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ff607d, stop:1 #d91c43);
    color: #ffffff;
    border: 1px solid #ff9bb0;
    font-size: 13px;
    font-weight: 800;
    padding: 11px 22px;
    border-radius: 11px;
}
QPushButton#stopBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ff8ba1, stop:1 #ee2750);
}
QPushButton#primary { background: #0c74ad; color: #ffffff; border-color: #35baff; }
QPushButton#primary:hover { background: #118dcc; }
QPushButton#ghost { background: transparent; border-color: #1c4660; color: #a9c3d8; }
QPushButton#ghost:hover { background: #0b2233; border-color: #2b9fd0; }
QPushButton#iconButton {
    background: #081a29;
    border: 1px solid #17425d;
    border-radius: 11px;
    padding: 0;
}
QPushButton#iconButton:hover {
    background: #0d2940;
    border-color: #40b9f2;
}
QPushButton#iconButton:disabled {
    background: #08131e;
    border-color: #122d40;
}
QPushButton#startBtn:disabled, QPushButton#stopBtn:disabled, QPushButton#primary:disabled {
    background: #0b1a27;
    color: #526b7e;
    border-color: #163247;
}

/* ---------- Campos ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #06111c;
    color: #ecf7ff;
    border: 1px solid #1d4661;
    border-radius: 8px;
    padding: 6px 9px;
    min-height: 17px;
    selection-background-color: #0b74b4;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid #45c6ff;
    padding: 5px 8px;
}
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled {
    color: #526b7e;
    background: #081520;
}
QLineEdit[invalid="true"] { border-color: #fb7185; }
QLineEdit#hotkeyInput {
    font-family: 'Cascadia Mono', 'Consolas', monospace;
    font-weight: 700;
    letter-spacing: 1px;
}
QLineEdit#hotkeyInput[capturing="true"] {
    border: 2px solid #fbbf24;
    background: #1d1807;
    color: #fbbf24;
    padding: 7px 9px;
}
QLineEdit#hotkeyInput[capturing="true"]:focus { border: 2px solid #fbbf24; }
QComboBox#headerCombo {
    background: #06121e;
    border: 1px solid #17425d;
    border-radius: 10px;
    padding: 7px 12px;
    min-height: 22px;
    color: #d7eaf8;
}
QComboBox#headerCombo:hover { border-color: #2b9fd0; }
QComboBox#headerCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
}
QComboBox QAbstractItemView {
    background: #081725;
    color: #d9e8f5;
    border: 1px solid #235676;
    border-radius: 8px;
    selection-background-color: #0b74b4;
    selection-color: #ffffff;
    outline: none;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    height: 50%;
    background: #0b2233;
    border-left: 1px solid #1d4661;
    border-top-right-radius: 7px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    height: 50%;
    background: #0b2233;
    border-left: 1px solid #1d4661;
    border-bottom-right-radius: 7px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background: #123d57; }
QSpinBox, QDoubleSpinBox { padding-right: 30px; }

/* ---------- Toggles ---------- */
QCheckBox {
    spacing: 8px;
    background: transparent;
    color: #d9e8f5;
    font-size: 12px;
    font-weight: 600;
}
QCheckBox::indicator {
    width: 40px;
    height: 22px;
    border: none;
    background: transparent;
    image: url("@TOGGLE_OFF@");
}
QCheckBox::indicator:hover { image: url("@TOGGLE_OFF@"); }
QCheckBox::indicator:checked { image: url("@TOGGLE_ON@"); }
QCheckBox::indicator:disabled { image: url("@TOGGLE_OFF@"); }

/* ---------- Abas ---------- */
QTabWidget::pane { border: none; margin-top: 8px; top: -1px; }
QTabBar { background: transparent; }
QTabBar::tab {
    background: #06111d;
    color: #6f8ba3;
    padding: 0 12px;
    min-height: 42px;
    margin-right: 6px;
    border: 1px solid #102c43;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.6px;
}
QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #168fff, stop:1 #0a5bc4);
    color: #ffffff;
    border-color: #58c4ff;
}
QTabBar::tab:hover:!selected { background: #0a1e2f; color: #c9e6f7; border-color: #17425d; }

QTabWidget#listTabs::pane { margin-top: 4px; }
QTabWidget#listTabs QTabBar::tab {
    min-height: 26px;
    padding: 0 10px;
    margin-right: 4px;
    border-radius: 7px;
    font-size: 9px;
    letter-spacing: 0.4px;
}
QTabWidget#listTabs QTabBar::tab:selected {
    background: #0d5f96;
    border-color: #2b9fdb;
    color: #eaf8ff;
}

/* ---------- Listas / Tabelas ---------- */
QTableWidget, QListWidget, QTextEdit, QTreeWidget {
    background: #06111c;
    alternate-background-color: #081725;
    border: 1px solid #173e58;
    border-radius: 9px;
    selection-background-color: #0b74b4;
    selection-color: #ffffff;
    gridline-color: #102b3d;
}
QListWidget::item { padding: 7px 8px; border-radius: 6px; }
QListWidget::item:hover { background: #0a2234; }
QListWidget::item:selected { background: #0b5f96; }
QHeaderView::section {
    background: #0a2032;
    color: #a9c3d8;
    padding: 9px;
    border: none;
    border-bottom: 1px solid #173e58;
    font-weight: 700;
}

/* ---------- Slider ---------- */
QSlider::groove:horizontal {
    height: 6px;
    background: #102d42;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0b74b4, stop:1 #43c9ff);
    border-radius: 3px;
}
QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
    background: #e9fbff;
    border: 2px solid #34bdf7;
}
QSlider::handle:horizontal:hover { background: #ffffff; border-color: #8fe7ff; }

/* ---------- Progresso ---------- */
QProgressBar {
    border: none;
    border-radius: 5px;
    background: #102b3d;
    text-align: center;
    min-height: 9px;
    max-height: 9px;
    color: #ffffff;
    font-weight: 700;
}
QProgressBar::chunk { background: #0b8fe0; border-radius: 5px; }
QProgressBar[health="good"] { color: #042213; }
QProgressBar[health="good"]::chunk { background: #34d399; }
QProgressBar[health="warning"] { color: #201800; }
QProgressBar[health="warning"]::chunk { background: #fbbf24; }
QProgressBar[health="critical"] { color: #ffffff; }
QProgressBar[health="critical"]::chunk { background: #fb7185; }
QProgressBar[health="unknown"] { color: #849bb2; }
QProgressBar[health="unknown"]::chunk { background: #214259; }

/* ---------- Diversos ---------- */
QStatusBar { background: #071421; color: #849bb2; }
QStatusBar::item { border: none; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QToolTip {
    background: #081725;
    color: #f4fbff;
    border: 1px solid #34bdf7;
    padding: 7px 9px;
    border-radius: 6px;
}
QSplitter::handle { background: #123149; }
QSplitter::handle:hover { background: #22d3ee; }
QScrollBar:vertical { background: transparent; width: 11px; margin: 2px; }
QScrollBar::handle:vertical { background: #21445c; min-height: 28px; border-radius: 5px; }
QScrollBar::handle:vertical:hover { background: #2f668a; }
QScrollBar:horizontal { background: transparent; height: 11px; margin: 2px; }
QScrollBar::handle:horizontal { background: #21445c; min-width: 28px; border-radius: 5px; }
QScrollBar::handle:horizontal:hover { background: #2f668a; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
